{
  "name": "qsgs-cost-database-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/pdf-assets.mjs && next dev --port 3100",
    "build": "node scripts/pdf-assets.mjs && prisma generate && next build",
    "start": "next start --port ${PORT:-3100}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/pdf-assets.mjs && prisma generate",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.4.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
