# Copy to .env for local development. Never commit .env.

# Local: started by `npm run db:local`. Railway sets this automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/costdb"

# Public address of the app (used in invite and reset links).
APP_URL="http://localhost:3100"
NEXTAUTH_URL="http://localhost:3100"
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# First admin, created by `npm run db:seed` only when no admin exists yet.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional: send invite / reset emails through Resend. Without it, admins copy links from the Users screen.
RESEND_API_KEY=""
EMAIL_FROM=""

# Extractor service (Python). Railway: use the private network address.
EXTRACTOR_URL="http://localhost:8100"
# Shared secret between web app and extractor. Same value on both services.
EXTRACTOR_TOKEN=""
# Same base64-encoded 32-byte secret in web and extractor; generate locally, never commit.
AI_KEYS_ENCRYPTION_KEY=""

# File storage for uploaded BOQs. Leave empty locally (files go to web/.local-storage).
# On Railway, set these from the storage bucket's credentials.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
